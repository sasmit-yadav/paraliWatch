# Copy to .env (which git ignores) and fill in what you need. Never commit .env.

# Optional. Turns on live mode: the current season's risk map from today's satellite data.
# Free key (takes a minute, sent by email): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Live mode: hours between background rebuilds while the dashboard runs (default 3),
# and PARALI_LIVE=0 to switch the background rebuild off (python -m parali live still works).
PARALI_LIVE_REFRESH_HOURS=3
PARALI_LIVE=1

# Optional. Where large raw downloads are cached (defaults to data/raw).
PARALI_CACHE=
