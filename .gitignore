# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data: raw downloads and intermediate files are rebuilt with `python -m parali data`
data/raw/
data/processed/
models/*.tmp

# Secrets
.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Model comparison: per-model predictions (large, regenerated by compare.py)
eval/model_comparison/preds/

# Assistant: downloaded models, built indexes, local databases and logs
data/models/
data/index/
data/assistant.db
data/logs/
data/bulletins/

# Documents checked and left out of the assistant (off-topic)
data/corpus_excluded/

# Corpus originals stay local; the repo ships the extracted text (data/corpus/pages.jsonl) and sources.csv
data/corpus/*.pdf
data/corpus/*.ocr.txt
data/corpus/*.html
!data/corpus/*_unverified.md
data/corpus/*.htm

# Phase 3: trained weights are regenerated by the scripts (the best burn-scar model is kept)
models/burn_scars/*.pt
!models/burn_scars/prithvi_finetune.pt
models/answer_lora/

# Phase 4: local MLflow store, traces and feedback
data/ops/
mlruns/
